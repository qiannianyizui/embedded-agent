#pragma once

// Compile-time feature toggles generated by CMake.

// HRR (Holographic Reduced Representations) vector symbolic architecture.
// When enabled, HolographicMemory uses HRR vectors for semantic retrieval
// and algebraic queries (probe/related/reason/contradict).
// When disabled, retrieval falls back to FTS5 + Jaccard similarity only.
#cmakedefine EA_ENABLE_HRR
